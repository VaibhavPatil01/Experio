<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&display=swap');
        
        body {
            margin: 0;
            padding: 0;
            background-color: #F1F5F9; 
            font-family: 'Outfit', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333333;
        }
        .email-wrapper {
            width: 100%;
            background-color: #F1F5F9;
            padding: 40px 0;
        }
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #FFFFFF;
            border-radius: 20px; 
            overflow: hidden;
            box-shadow: 0 4px 12px rgba(0, 46, 125, 0.08); 
        }
        .header {
            background-color: #F1F5F9;
            text-align: center;
            padding: 20px 20px 0px 20px; 
        }
        .header img {
            max-width: 180px;
            height: auto;
        }
        .content {
            padding: 40px 40px 40px 40px; 
            text-align: center;
        }
        .illustration {
            width: 100%;
            max-width: 350px;
            height: auto;
            margin-bottom: 15px;
        }
        .text-container {
            text-align: center;
        }
        .greeting {
            font-size: 26px;
            font-weight: 700;
            margin: 0 0 8px 0;
            color: #001233; /* Dark navy */
        }
        .text {
            font-size: 16px;
            line-height: 1.6;
            color: #4A5568;
            margin: 0 0 8px 0;
        }
        .btn {
            display: inline-block;
            background-color: #002e7d; 
            color: #FFFFFF !important;
            text-decoration: none;
            padding: 14px 28px;
            font-size: 16px;
            font-weight: 500;
            border-radius: 8px;
            margin-top: 10px;
            margin-bottom: 10px;
        }
        .expiration {
            font-size: 14px;
            color: #4A5568;
            text-align: center;
        }
        .expiration img {
            width: 16px;
            height: 16px;
            margin-right: 4px;
            vertical-align: middle;
            margin-top: -2px;
        }
        .expiration .highlight {
            color: #002e7d;
            font-weight: 600;
        }
        .footer {
            background-color: #F1F5F9;
            padding: 25px 20px 20px 20px;
            text-align: center;
        }
        .footer-greeting {
            font-size: 16px;
            color: #555555;
            margin: 0 0 5px 0;
        }
        .footer-team {
            font-size: 18px;
            font-weight: 700;
            color: #002e7d;
            margin: 0 0 20px 0;
        }
        .social-icons {
            margin-bottom: 15px;
        }
        .social-icons a {
            display: inline-block;
            margin: 0 8px;
            text-decoration: none;
            background-color: #001233; 
            border-radius: 50%;
            width: 36px;
            height: 36px;
            line-height: 36px; 
            text-align: center;
        }
        .social-icons img {
            width: 18px;
            height: 18px;
            vertical-align: middle;
            margin-top: -3px; /* Minor adjustment for perfect visual center */
        }
        .footer-bottom {
            padding-top: 0;
        }
        .footer-copy {
            color: #888888;
            font-size: 13px;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="email-wrapper">
        <div class="header">
            <!-- Actual Logo -->
            <img src="https://i.postimg.cc/NjfNSy55/emaillogo-Photoroom.png" alt="Experio Logo">
        </div>

        <div class="email-container">
            <div class="content">
                <!-- Actual Hero Image -->
                <img src="https://i.postimg.cc/DZ6rh6WB/verifyemailhero-(1).png" alt="Verify Email Illustration" class="illustration">
                
                <div class="text-container">
                    <h1 class="greeting">Hello {{username}}!</h1>
                    <p class="text">Welcome to Experio! We are thrilled to have you on board.</p>
                    <p class="text">Please verify your email address to activate your account and get started.</p>
                    
                    <a href="{{verificationURL}}" class="btn">
                        Verify Email
                    </a>
                </div>
            </div>
        </div>

        <div class="footer">
            <p class="footer-greeting">Thank you,</p>
            <p class="footer-team">The Experio Team</p>

            <div class="social-icons">
                <a href="https://github.com/VaibhavPatil01/Experio" target="_blank"><img src="https://img.icons8.com/ios-filled/50/ffffff/github.png" alt="GitHub"></a>
                <a href="https://www.linkedin.com/in/vaibhav-patil13" target="_blank"><img src="https://img.icons8.com/ios-filled/50/ffffff/linkedin.png" alt="LinkedIn"></a>
                <a href="#"><img src="https://img.icons8.com/ios-filled/50/ffffff/email.png" alt="Mail"></a>
                <a href="#"><img src="https://img.icons8.com/ios-filled/50/ffffff/domain.png" alt="Website"></a>
            </div>
            
            <div class="footer-bottom">
                <p class="footer-copy">© 2026 Experio. All rights reserved.</p>
            </div>
        </div>
    </div>
</body>
</html>